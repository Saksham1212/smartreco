# ---------------------------------------------------------------------------
# SmartReco environment configuration.
# Copy this file to .env and fill in real values. .env is gitignored.
# ---------------------------------------------------------------------------

# Mesh API — OpenAI-SDK compatible gateway. ALL LLM/embedding calls go through this.
MESH_API_KEY=
MESH_BASE_URL=https://api.meshapi.ai/v1
CHAT_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

# Auth — JWT signing secret. Generate a long random string for production.
APP_SECRET_KEY=change-me-to-a-long-random-string

# Database
DATABASE_URL=sqlite+aiosqlite:///./smartreco.db

# Vector store (ChromaDB, in-process, persisted to disk)
CHROMA_PERSIST_PATH=./chroma_db
CHROMA_COLLECTION_NAME=products

# Recommendation agent trigger threshold — number of new events since the
# last recommendation before the agent runs again.
AGENT_TRIGGER_THRESHOLD=8

# First-run admin account (auto-created on startup if no admin exists)
ADMIN_EMAIL=admin@smartreco.local
ADMIN_PASSWORD=change-this-password

# Email / SMTP (daily digest)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@smartreco.local
EMAIL_ENABLED=false
DAILY_DIGEST_HOUR=17
DAILY_DIGEST_MINUTE=0

# Misc
DEBUG=false

# LangSmith observability (optional bonus). Tracing only activates if
# LANGCHAIN_TRACING_V2=true — leave it false and the app runs identically,
# just without traces. Get a free key at https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=smartreco
